{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebDynamite",
  "version": "0.1.0",
  "identifier": "com.webdynamite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WebDynamite",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/webdynamite-core.exe": "webdynamite-core.exe",
      "../scripts/windows/install-core-service.ps1": "install-core-service.ps1",
      "../scripts/windows/manage-core-service.ps1": "manage-core-service.ps1",
      "../scripts/windows/provision-service-layout.ps1": "provision-service-layout.ps1",
      "../scripts/windows/provision-trusted-service-config.ps1": "provision-trusted-service-config.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
